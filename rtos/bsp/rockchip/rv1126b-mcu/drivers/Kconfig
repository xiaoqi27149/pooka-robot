source "$BSP_DIR/../common/drivers/Kconfig"

menu "RT-Thread rockchip rv1126b drivers"

config RT_USING_CRU
    bool "Enable CRU"
    default n

if RT_USING_I2C
menu "Enable I2C"
    config RT_USING_I2C0
        bool "Enable I2C0"
        default n

    config RT_USING_I2C1
        bool "Enable I2C1"
        default n

    config RT_USING_I2C2
        bool "Enable I2C2"
        default n

    config RT_USING_I2C3
        bool "Enable I2C3"
        default n

    config RT_USING_I2C4
        bool "Enable I2C4"
        default n

    config RT_USING_I2C5
        bool "Enable I2C5"
        default n
endmenu
endif

if RT_USING_PWM
menu "Enable PWM"
    config RT_USING_PWM0
        bool "Enable PWM0"
        default n

    config RT_USING_PWM1
        bool "Enable PWM1"
        default n

    config RT_USING_PWM2
        bool "Enable PWM2"
        default n

    config RT_USING_PWM3
        bool "Enable PWM3"
        default n
endmenu
endif

menu "Enable Multi Saradc"
config RT_USING_MULTI_SARADC
    bool "Enable SARADC"
    select RT_USING_ADC
    default n

    if RT_USING_MULTI_SARADC
        config RT_USING_SARADC0
            bool "Enable Saradc0"
            default n

        config RT_USING_SARADC1
            bool "Enable Saradc1"
            default n

        config RT_USING_SARADC2
            bool "Enable Saradc2"
            default n
    endif
endmenu

menu "Enable UART"
    config RT_USING_UART
        bool "Enable UART"
        default y

    if RT_USING_UART
    config RT_USING_UART0
        bool "Enable UART0"
        default n

    config RT_USING_UART2
        bool "Enable UART2"
        default n

    config RT_USING_UART4
        bool "Enable UART4"
        default n
    endif
endmenu

endmenu

