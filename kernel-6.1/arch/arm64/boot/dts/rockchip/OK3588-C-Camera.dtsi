/*
 * Copyright (c) 2022 Forlinx Co., Ltd.
 *

 * rkisp0 --> rkisp0_vir0/rkisp0_vir1/rkisp0_vir2/rkisp0_vir3
 * rkisp1 --> rkisp1_vir0/rkisp1_vir1/rkisp1_vir2/rkisp1_vir3

 * rkcif_mipi_lvds --> rkcif_mipi_lvds[0-4]_sditf

 * mipicamera0 --> csi2_dcphy0 --> mipi0_csi2 -->rkcif_mipi_lvds  --> rkcif_mipi_lvds_sditf  --> rkisp0_vir0
 * mipicamera1 --> csi2_dcphy1 --> mipi1_csi2 -->rkcif_mipi_lvds1 --> rkcif_mipi_lvds1_sditf --> rkisp1_vir0
	
 * csi2_dphy0 or (csi2_dphy1、csi2_dphy2)	dphy0
 * csi2_dphy3 or (csi2_dphy4、csi2_dphy5)	dphy1

 * mipicamera2 --> csi2_dphy1 -->  mipi2_csi2 -->rkcif_mipi_lvds2 -->rkcif_mipi_lvds2_sditf  --> rkisp0_vir1
 * mipicamera3 --> csi2_dphy2 -->  mipi3_csi2 -->rkcif_mipi_lvds3 -->rkcif_mipi_lvds3_sditf  --> rkisp0_vir2
 * mipicamera4 --> csi2_dphy4 -->  mipi4_csi2 -->rkcif_mipi_lvds4 -->rkcif_mipi_lvds4_sditf  --> rkisp1_vir1
 * mipicamera5 --> csi2_dphy5 -->  mipi5_csi2 -->rkcif_mipi_lvds5 -->rkcif_mipi_lvds5_sditf  --> rkisp1_vir2

 * mipicamera6 --> rkcif_dvp ---> rkcif_dvp_sditf
 */

/ {
    	ext_cam_clk: external-camera-clock {
            compatible = "fixed-clock";
            clock-frequency = <24000000>;
            clock-output-names = "CLK_CAMERA_24MHZ";
            #clock-cells = <0>;
    	};

    	vcc1v8_cam: vcc1v8-cam {
            compatible = "regulator-fixed";
            regulator-name = "vcc1v8_cam";
            regulator-always-on;
            regulator-boot-on;
            regulator-min-microvolt = <1800000>;
            regulator-max-microvolt = <1800000>;
            vin-supply = <&vcc3v3_sys>;
        };

        vcc1_2v8: vcc1-2v8 {
            compatible = "regulator-fixed";
            regulator-name = "vcc1_2v8";
            regulator-always-on;
            regulator-boot-on;
            regulator-min-microvolt = <2800000>;
            regulator-max-microvolt = <2800000>;
            vin-supply = <&vcc3v3_sys>;
        };

        vcc2_2v8: vcc2-2v8 {
            compatible = "regulator-fixed";
            regulator-name = "vcc2_2v8";
            regulator-always-on;
            regulator-boot-on;
            regulator-min-microvolt = <2800000>;
            regulator-max-microvolt = <2800000>;
            vin-supply = <&vcc3v3_sys>;
        };

        vcc1v2_c1: vcc1v2-c1 {
            compatible = "regulator-fixed";
            regulator-name = "vcc1v2_c1";
            regulator-always-on;
            regulator-boot-on;
            regulator-min-microvolt = <1200000>;
            regulator-max-microvolt = <1200000>;
            vin-supply = <&vcc3v3_sys>;
        };

        vcc1v2_c2: vcc1v2-c2 {
            compatible = "regulator-fixed";
            regulator-name = "vcc1v2_c2";
            regulator-always-on;
            regulator-boot-on;
            regulator-min-microvolt = <1200000>;
            regulator-max-microvolt = <1200000>;
            vin-supply = <&vcc3v3_sys>;
        };

        vcc1v5_c3: vcc1v5-c3 {
            compatible = "regulator-fixed";
            regulator-name = "vcc1v5_c3";
            regulator-always-on;
            regulator-boot-on;
            regulator-min-microvolt = <1500000>;
            regulator-max-microvolt = <1500000>;
            vin-supply = <&vcc3v3_sys>;
        };

        vcc1v5_c4: vcc1v5-c4 {
            compatible = "regulator-fixed";
            regulator-name = "vcc1v5_c4";
            regulator-always-on;
            regulator-boot-on;
            regulator-min-microvolt = <1500000>;
            regulator-max-microvolt = <1500000>;
            vin-supply = <&vcc3v3_sys>;
        };

        vcc1v5_c5: vcc1v5-c5 {
            compatible = "regulator-fixed";
            regulator-name = "vcc1v5_c5";
            regulator-always-on;
            regulator-boot-on;
            regulator-min-microvolt = <1500000>;
            regulator-max-microvolt = <1500000>;
            vin-supply = <&vcc3v3_sys>;
        };
};

&rkcif {
    status = "okay";
};

&rkcif_mmu {
    status = "okay";
};


//************************************************
//***  CAM1 OV13855 Configuration description  ***
//************************************************

&mipi_dcphy0 {
    status = "okay";
};

&rkisp0 {
    status = "okay";
};

&isp0_mmu {
    status = "okay";
};

&i2c3 {
    status = "okay";
    clock-frequency = <400000>;

    vm149c_0: vm149c@0c {
        compatible = "silicon touch,vm149c";
        status = "disabled";
        reg = <0x0c>;
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
	};

    cam1_ov13850: cam1_ov13850@10 {
        compatible = "ovti,ov13850";
        status = "disabled";
        reg = <0x10>;

        clocks = <&ext_cam_clk>;
        clock-names = "xvclk";

        pwdn-gpios = <&extio EXTIO_GPIO_P01 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&extio EXTIO_GPIO_P00 GPIO_ACTIVE_HIGH>;
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
        rockchip,camera-module-name = "forlinx";
        rockchip,camera-module-lens-name = "default"; 
	lens-focus = <&vm149c_0>;

        port {
            cam1_ov13850_out: endpoint {
                remote-endpoint = <&mipi_in_0_ucam1>;
                data-lanes = <1 2 3 4>;
            };
        };
    };

    cam1_dw9763: cam1-dw9763@c {
        compatible = "dongwoon,dw9763";
        status = "okay";
        reg = <0x0c>;
        rockchip,vcm-max-current = <120>;
        rockchip,vcm-start-current = <20>;
        rockchip,vcm-rated-current = <90>;
        rockchip,vcm-step-mode = <3>;
        rockchip,vcm-t-src = <0x20>;
        rockchip,vcm-t-div = <1>;
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
    };

    cam1_ov13855: cam1-ov13855@36 {
        compatible = "ovti,ov13855";
        status = "disabled";
        reg = <0x36>;

        clocks = <&ext_cam_clk>;
        clock-names = "xvclk";
	power-domains = <&power RK3588_PD_VI>;
        pwdn-gpios = <&extio EXTIO_GPIO_P01 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&extio EXTIO_GPIO_P00 GPIO_ACTIVE_HIGH>;
	avdd-supply = <&vcc1_2v8>;
	dovdd-supply = <&vcc1v8_cam>;
	dvdd-supply = <&vcc1v2_c1>;
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
        rockchip,camera-module-name = "CMK-OT2016-FV1";
        rockchip,camera-module-lens-name = "default";
        lens-focus = <&cam1_dw9763>;
        port {
            cam1_ov13855_out: endpoint {
            remote-endpoint = <&mipi_in_0_ucam1>;
            data-lanes = <1 2 3 4>;
            };
        };
    };

    cam1_sc132gs: cam1-sc132gs@33 {
        compatible = "smartsens,sc132gs";
        status = "okay";
        reg = <0x33>;

        clocks = <&ext_cam_clk>;
        clock-names = "xvclk";
	power-domains = <&power RK3588_PD_VI>;
        reset-gpios = <&extio EXTIO_GPIO_P00 GPIO_ACTIVE_LOW>;
	avdd-supply = <&vcc1_2v8>;
	dovdd-supply = <&vcc1v8_cam>;
	dvdd-supply = <&vcc1v2_c1>;
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
        rockchip,camera-module-name = "forlinx";
        rockchip,camera-module-lens-name = "default";
        port {
            cam1_sc132gs_out: endpoint {
            remote-endpoint = <&mipi_in_0_ucam1>;
            data-lanes = <1 2>;
            };
        };
    };
};

&csi2_dcphy0 {
    status = "okay";
    ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;
            mipi_in_0_ucam1: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&cam1_sc132gs_out>;
                data-lanes = <1 2>;
            };
        };
        port@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;
            csidcphy0_out: endpoint@0 {
                reg = <0>;
                remote-endpoint = <&mipi0_csi2_input>;
            };
        };
    };
};

&mipi0_csi2 {
    status = "okay";
    ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;
            mipi0_csi2_input: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&csidcphy0_out>;
            };
        };
        port@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;
            mipi0_csi2_output: endpoint@0 {
                reg = <0>;
                remote-endpoint = <&cif_mipi_lvds0>;
            };
        };
    };
};

&rkcif_mipi_lvds {
    status = "okay";
    port {
        cif_mipi_lvds0: endpoint {
            remote-endpoint = <&mipi0_csi2_output>;
        };
    };
};

&rkcif_mipi_lvds_sditf {
    status = "okay";
    port {
        mipi_lvds_sditf: endpoint {
            remote-endpoint = <&isp0_vir0>;
        };
    };
};

&rkisp0_vir0 {
    status = "okay";
    port {
        #address-cells = <1>;
        #size-cells = <0>;
        isp0_vir0: endpoint@0 {
            reg = <0>;
            remote-endpoint = <&mipi_lvds_sditf>;
        };
    };
};

