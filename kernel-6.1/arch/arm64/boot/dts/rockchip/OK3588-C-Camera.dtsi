//************************************************
//***  CAM5 OV5645 Configuration Description  ****
//************************************************

&i2c4 {
    status = "okay";
	
    cam5_ov5645: cam5_ov5645@3c {
        status = "okay";
        compatible = "ovti,ov5645";
        reg = <0x3c>;
