<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rkros_zcopy_ctl</name>
  <version>0.0.1</version>
  <description>
    A minimal RKROS package that allows other packages to turn on
    inter-process zero-copy via shared memory (Fast-DDS).
  </description>
  <maintainer email="robot@rock-chips.com">Robot</maintainer>
  <license>Apache-2.0</license>

  <depend>ament_index_cpp</depend>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rmw_fastrtps_cpp</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
