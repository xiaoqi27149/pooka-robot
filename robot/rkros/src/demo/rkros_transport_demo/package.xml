<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rkros_transport_demo</name>
  <version>0.0.1</version>
  <description>
    A demo package for rkros transport capabilities, including
    zero-copy via shared memory (Fast-DDS) and dmabuf based image message.
  </description>
  <maintainer email="cmy@rock-chips.com">albuer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>builtin_interfaces</depend>
  <depend>rosidl_default_runtime</depend>
  <depend>rkros_zcopy_msgs</depend>
  <depend>rkros_zcopy_ctl</depend>
  <depend>rkros_dmabuf</depend>
  <depend>sensor_msgs</depend>
  <depend>rkros_common</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
